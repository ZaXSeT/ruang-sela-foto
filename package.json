{
	"name": "03-ruang-sela-foto",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "eslint .",
		"test": "svelte-kit sync && vitest run",
		"db:start": "tsx scripts/db-local.ts",
		"db:migrate": "tsx scripts/migrate.ts",
		"db:seed": "tsx scripts/seed.ts",
		"db:setup": "npm run db:migrate && npm run db:seed",
		"build:local": "vite build --mode node",
		"start:local": "node --env-file=.env scripts/start-local.mjs",
		"images": "tsx scripts/images.ts",
		"pertanyaan": "tsx scripts/pertanyaan.ts"
	},
	"dependencies": {
		"postgres": "^4.1.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/karla": "^5.3.0",
		"@fontsource/cormorant-garamond": "^5.3.0",
		"@sveltejs/adapter-node": "^6.0.5",
		"@sveltejs/adapter-vercel": "^7.0.5",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^26.6.6",
		"embedded-postgres": "^19.0.0-beta.20",
		"eslint": "^10.15.0",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"sharp": "^0.35.5",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.74.0",
		"vite": "^8.3.8",
		"vitest": "^5.1.1"
	}
}
